# Test runner image: Go toolchain + sox + audiowaveform
# Build: docker build -f go/Dockerfile.test -t session-recorder-test .
# Run:   docker run --rm session-recorder-test

# --- Stage 1: Build audiowaveform from source ---
FROM alpine:latest AS audiowaveform-builder

RUN apk add --no-cache \
    git make cmake gcc g++ \
    libmad-dev libid3tag-dev libsndfile-dev \
    gd-dev boost-dev libgd libpng-dev zlib-dev \
    autoconf automake libtool gettext

WORKDIR /tmp
RUN wget https://github.com/xiph/flac/archive/1.3.3.tar.gz && \
    tar xzf 1.3.3.tar.gz && \
    cd flac-1.3.3 && \
    ./autogen.sh && \
    ./configure --enable-shared=no && \
    make && \
    make install

RUN git clone https://github.com/bbc/audiowaveform.git && \
    cd audiowaveform && \
    mkdir build && \
    cd build && \
    cmake -DENABLE_TESTS=0 .. && \
    make && \
    make install

# --- Stage 2: Test runner with Go + audio tools ---
FROM golang:1.24-alpine

# Runtime dependencies for sox and audiowaveform, plus gcc/musl-dev for CGO (needed by -race)
RUN apk --no-cache add ca-certificates sox \
    libmad libid3tag libsndfile gd libgd libpng zlib \
    boost1.84-filesystem boost1.84-program_options \
    gcc musl-dev

# Copy audiowaveform binary
COPY --from=audiowaveform-builder /usr/local/bin/audiowaveform /usr/local/bin/audiowaveform

WORKDIR /app

# Copy go module files first for caching
COPY go/go.mod go/go.sum ./
COPY protocols ../protocols

RUN go mod download

# Copy source
COPY go/ .

# Update dependencies
RUN go mod tidy && go mod download

ENV CGO_ENABLED=1

CMD ["go", "test", "-v", "-race", "-count=1", "./..."]
