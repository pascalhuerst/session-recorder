#!/bin/sh
set -e

USER=session-recorder-alsa-reader
GROUP=session-recorder-alsa-reader

case "$1" in
  configure)
    if ! getent group "$GROUP" >/dev/null 2>&1; then
      addgroup --system "$GROUP"
    fi
    if ! getent passwd "$USER" >/dev/null 2>&1; then
      adduser --system --no-create-home --ingroup "$GROUP" \
        --shell /usr/sbin/nologin "$USER"
    fi
    # Soundcard / input access is granted at runtime via the unit's
    # SupplementaryGroups=audio input, so no group edits are needed here.
    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload || true
    fi
    echo "session-recorder-alsa-reader installed. Edit /etc/default/session-recorder-alsa-reader,"
    echo "then: systemctl enable --now session-recorder-alsa-reader"
    ;;
esac

exit 0
